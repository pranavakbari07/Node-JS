<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>📝Edit To-Do List</title>
</head>

<body style="
    margin:0;
    padding:30px;
    font-family:'Segoe UI', Arial, sans-serif;
    background:linear-gradient(135deg,#e0e7ff,#f8fafc);
">

     <h1 style="
        text-align:center;
        color:#1e293b;
        margin-bottom:25px;
    ">
        📝Edit To-Do List in Express JS
    </h1>

    <!-- FORM -->
    <form action="/updateData" method="post" style="
        max-width:700px;
        margin:0 auto 30px;
        background:#ffffff;
        padding:20px;
        border-radius:12px;
        box-shadow:0 10px 25px rgba(0,0,0,0.12);
    ">
        <input type="text" value="<%=singleData.id%>" name="id" hidden>

        <input type="text" name="task" value="<%=singleData.task%>" placeholder="Task title" style="
            width:100%;
            padding:10px;
            margin-bottom:10px;
            border-radius:8px;
            border:1px solid #c7d2fe;
        ">

        <input type="text" name="description" value="<%=singleData.description%>" placeholder="Task description" style="
            width:100%;
            padding:10px;
            margin-bottom:10px;
            border-radius:8px;
            border:1px solid #c7d2fe;
        ">

        <div style="display:flex; gap:10px; flex-wrap:wrap; margin-bottom:10px;">
            <select name="priority" value="<%=singleData.priority%>" style="
                flex:1;
                padding:10px;
                border-radius:8px;
                border:1px solid #c7d2fe;
            ">
                <option value="Low">Low</option>
                <option value="Medium">Medium</option>
                <option value="High">High</option>
            </select>

            <input type="date" value="<%=singleData.dueDate%>" name="dueDate" style="
                flex:1;
                padding:10px;
                border-radius:8px;
                border:1px solid #c7d2fe;
            ">
        </div>

        <select name="status" value="<%=singleData.status%>" style="
            width:100%;
            padding:10px;
            margin-bottom:15px;
            border-radius:8px;
            border:1px solid #c7d2fe;
        ">
            <option value="Pending">Pending</option>
            <option value="Completed">Completed</option>
        </select>

        <button type="submit" style="
            width:100%;
            padding:10px;
            background:#4f46e5;
            color:white;
            border:none;
            border-radius:8px;
            cursor:pointer;
        ">
           UpdateData
        </button>
    </form>

</body>
</html>