<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>📝 To-Do List</title>
</head>

<body style="
    margin:0;
    padding:30px;
    font-family:'Segoe UI', Arial, sans-serif;
    background:linear-gradient(135deg,#e0e7ff,#f8fafc);
">

    <h1 style="
        text-align:center;
        color:#1e293b;
        margin-bottom:25px;
    ">
        📝 To-Do List in Express JS
    </h1>

    <!-- FORM -->
    <form action="/addData" method="post" style="
        max-width:700px;
        margin:0 auto 30px;
        background:#ffffff;
        padding:20px;
        border-radius:12px;
        box-shadow:0 10px 25px rgba(0,0,0,0.12);
    ">

        <input type="text" name="task" placeholder="Task title" style="
            width:97%;
            padding:10px;
            margin-bottom:10px;
            border-radius:8px;
            border:1px solid #c7d2fe;
        ">

        <input type="text" name="description" placeholder="Task description" style="
            width:97%;
            padding:10px;
            margin-bottom:10px;
            border-radius:8px;
            border:1px solid #c7d2fe;
        ">

        <div style="display:flex; gap:10px; flex-wrap:wrap; margin-bottom:10px;">
            <select name="priority" style="
                flex:1;
                padding:10px;
                border-radius:8px;
                border:1px solid #c7d2fe;
">
                <option hidden>Select Your Priority</option>
                <option value="Low">Low</option>
                <option value="Medium">Medium</option>
                <option value="High">High</option>
            </select>

            <input type="date" name="dueDate" style="
                flex:1;
                padding:10px;
                border-radius:8px;
                border:1px solid #c7d2fe;">
        </div>

        <select name="status" style="
            width:100%;
            padding:10px;
            margin-bottom:15px;
            border-radius:8px;
            border:1px solid #c7d2fe;
        ">
            <option hidden>Select Your Status</option>
            <option value="Pending">Pending</option>
            <option value="Completed">Completed</option>
        </select>

        <button type="submit" style="
            width:100%;
            padding:10px;
            background:#4f46e5;
            color:white;
            border:none;
            border-radius:8px;
            cursor:pointer;
        ">
            ➕ Add Task
        </button>
    </form>

    <!-- TABLE -->
    <% if(arr && arr.length> 0){ %>
        <div style="
            max-width:900px;
            margin:0 auto;
            background:white;
            padding:20px;
            border-radius:12px;
            box-shadow:0 10px 25px rgba(0,0,0,0.12);
            overflow-x:auto;
        ">
            <table style="
                width:100%;
                border-collapse:collapse;
                text-align:left;
            ">
                <thead>
                    <tr style="background:#eef2ff;">
                        <th style="padding:10px;">Task</th>
                        <th style="padding:10px;">Description</th>
                        <th style="padding:10px;">Priority</th>
                        <th style="padding:10px;">Due Date</th>
                        <th style="padding:10px;">Status</th>
                        <th style="padding:10px;">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    <% arr.map((e)=>{ %>
                        <tr style="border-bottom:1px solid #e5e7eb;">
                            <td style="padding:10px;"><b>
                                    <%= e.task %>
                                </b></td>
                            <td style="padding:10px;">
                                <%= e.description %>
                            </td>
                            <td style="padding:10px;">
                                <%= e.priority %>
                            </td>
                            <td style="padding:10px;">
                                <%= e.dueDate %>
                            </td>
                            <td style="padding:10px;">
                                <%= e.status==='Completed' ? '✅ Completed' : '⏳ Pending' %>
                            </td>
                            <td style="padding:10px; white-space:nowrap;">

                                <a href="/editData?id=<%= e.id %>" style="
                                    background:#22c55e;
                                    color:white;
                                    padding:6px 12px;
                                    border-radius:6px;
                                    text-decoration:none;
                                    display:inline-block;
                                    margin-right:6px;
                                    font-size:14px;
                                ">
                                    Edit
                                </a>

                                <a href="/deleteData/<%= e.id %>" style="
                                    background:#ef4444;
                                    color:white;
                                    padding:6px 12px;
                                    border-radius:6px;
                                    text-decoration:none;
                                    display:inline-block;
                                    font-size:14px;
                                ">
                                    Delete
                                </a>

                            </td>

                        </tr>
                        <% }) %>
                </tbody>
            </table>
        </div>
        <% } else { %>
            <div style="
        max-width:600px;
        margin:40px auto;
        padding:30px;
        text-align:center;
        background:white;
        border-radius:14px;
        box-shadow:0 10px 25px rgba(0,0,0,0.12);
        color:#475569;
    ">
                <div style="font-size:48px; margin-bottom:10px;">😴</div>
                <h2 style="margin:0 0 8px; color:#1e293b;">
                    No Tasks Found
                </h2>
                <p style="margin:0; font-size:15px;">
                    Abhi tak koi task add nahi kiya gaya hai.<br>
                    Upar se apna pehla task add karo 🚀
                </p>
            </div>
            <% } %>


</body>

</html>