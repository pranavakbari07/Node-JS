<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="min-h-screen bg-gradient-to-br from-zinc-950 via-zinc-900 to-zinc-950">
  <%- include('partials/navbar') %>
  <main class="max-w-2xl mx-auto px-4 sm:px-6 py-12">
    <h1 class="text-3xl font-bold text-white font-serif mb-8"><%= article ? 'Edit Article' : 'New Article' %></h1>
    <% if (typeof error !== 'undefined' && error) { %>
    <div class="mb-6 p-4 rounded-xl bg-red-500/10 border border-red-500/30 text-red-400 text-sm"><%= error %></div>
    <% } %>
    <div class="bg-zinc-900/60 backdrop-blur-sm border border-zinc-800 rounded-2xl p-8 shadow-xl">
      <form method="POST" action="<%= article ? `/articles/${article._id}?_method=PUT` : '/articles' %>" class="space-y-6">
        <div>
          <label for="title" class="block text-sm font-medium text-zinc-300 mb-2">Title</label>
          <input type="text" id="title" name="title" value="<%= article ? article.title : '' %>" required
            class="w-full px-4 py-3 rounded-xl bg-zinc-800/80 border border-zinc-700 text-white placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-amber-500/50 focus:border-amber-500 transition-all">
        </div>
        <div>
          <label for="content" class="block text-sm font-medium text-zinc-300 mb-2">Content</label>
          <textarea id="content" name="content" rows="12" required
            class="w-full px-4 py-3 rounded-xl bg-zinc-800/80 border border-zinc-700 text-white placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-amber-500/50 focus:border-amber-500 transition-all resize-y"><%= article ? article.content : '' %></textarea>
        </div>
        <div class="flex gap-3">
          <button type="submit" class="px-6 py-2.5 rounded-xl bg-amber-500 text-zinc-900 font-semibold hover:bg-amber-400 active:scale-[0.98] transition-all">
            <%= article ? 'Update' : 'Create' %> Article
          </button>
          <a href="<%= article ? `/articles/${article._id}` : '/articles' %>" class="px-6 py-2.5 rounded-xl border border-zinc-600 text-zinc-300 hover:border-zinc-500 hover:text-white transition-colors">
            Cancel
          </a>
        </div>
      </form>
    </div>
  </main>
  <script src="/js/navbar.js"></script>
</body>
</html>
