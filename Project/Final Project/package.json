{
  "name": "blog-project",
  "version": "1.0.0",
  "description": "Blog with JWT, role-based access, and multiuser support",
  "main": "server.js",
  "scripts": {
    "start": "npm run build:css && node server.js",
    "dev": "concurrently \"npm run watch:css\" \"node server.js\"",
    "build:css": "postcss ./src/input.css -o ./public/css/tailwind.css",
    "watch:css": "postcss ./src/input.css -o ./public/css/tailwind.css --watch"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "cookie-parser": "^1.4.7",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "method-override": "^3.0.0",
    "mongoose": "^8.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "autoprefixer": "^10.4.24",
    "concurrently": "^8.2.2",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^4.2.1"
  }
}
