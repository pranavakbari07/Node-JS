<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book store</title>
</head>
<body>
    <h1>Edit Book Details</h1>
    <form action="/updateData" method="post">
        <input type="text" name="id" value="<%=singleData.id%>" hidden>
        <input type="text" value="<%=singleData.name%>" name="name" placeholder="Enter Book Name" required>
        <input type="text" value="<%=singleData.author%>" name="author" placeholder="Enter Author Name" required>
        <input type="number" value="<%=singleData.quantity%>" name="quantity" placeholder="Enter Your Book Quantity" required>
        <input type="number" value="<%=singleData.price%>" name="price" placeholder="Enter Book Price" required>
        <input type="submit" style="cursor: pointer" value="Update Book">
    </form>
</body>
</html>