<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MongoDB CRUD</title>
</head>
<body>
    <h1>Edit Records</h1>
    <form action="/updateData" method="post">
        <input type="text" name="id" value="<%=singleData.id%>" hidden />
        <input type="text" name="name" value="<%=singleData.name%>" placeholder="Enter your name" />
        <input type="number" name="age" value="<%=singleData.age%>" placeholder="Enter your age" />
        <input type="submit" value="Update" />
    </form>
</body>
</html>